generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  USUARIO
  ADMIN
}

enum Sexo {
  MASCULINO
  FEMENINO
}

model Videojuego {
  id String @id @default(uuid())
  nombre String
  fecha DateTime @default(now()) 
  estado String
  categoria_id String?
  categoria Categoria? @relation(fields: [categoria_id], references: [id])
  plataformas Plataforma[] @relation("Videojuego_Plataforma")
}

model Categoria {
  id String @id @default(uuid())
  nombre String
  videojuegos Videojuego[]
}

model Plataforma {
  id String @id @default(uuid())
  nombre String
  videojuegos Videojuego[] @relation("Videojuego_Plataforma")
}

model Usuario {
  id String @id @default(uuid())
  username String
  password String
  rol Rol
  estado Boolean
  perfil Perfil?
}

model Perfil {
  id String @id @default(uuid())
  nombre String
  apellido String
  sexo Sexo
  usuario_id String @unique
  usuario Usuario @relation(fields: [usuario_id], references: [id])
}
